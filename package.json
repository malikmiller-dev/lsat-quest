{
  "name": "lsat-quest",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:vendor": "node scripts/build-vendor.mjs",
    "verify:vendor": "node scripts/build-vendor.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build-notices.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "python e2e/browser_tests.py",
    "audit:dependencies": "npm audit --audit-level=moderate --include=dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run verify:vendor && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "dexie": "file:vendor/dexie",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/postcss": "4.1.16",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.11",
    "eslint": "9.39.1",
    "fake-indexeddb": "file:vendor/fake-indexeddb",
    "globals": "16.4.0",
    "jsdom": "27.0.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
